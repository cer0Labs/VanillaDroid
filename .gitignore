# Local configuration (may contain account names/addresses)
/config/*.cfg
!/config/*.example.cfg

# Profiling captures
*.tracy
*.perfetto-trace
*.gfxtrace

# Third-party APKs tested locally
/outputs/

# Local developer tools (Tracy profiler GUI, etc.)
/.tools/

# Signing keys: NEVER commit (the release key lives outside every repository)
*.jks
*.keystore
*.p12
*.pem
!/tests/data/release-test-key.pem
