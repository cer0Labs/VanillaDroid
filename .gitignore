# Build output
/build/
/out/
.cxx/
.gradle/
apps/android/app/build/
apps/android/build/
apps/android/local.properties
*.apk
!/tests/data/updates/*.apk
*.aab

# IDEs
.vs/
.vscode/
.idea/
*.user
*.iml

# Blizzard data and anything derived from it: NEVER commit
*.MPQ
*.mpq
*.blp
*.BLP
*.m2
*.M2
*.wmo
*.WMO
*.adt
*.wdt
*.wdl
*.dbc
*.vdpk
