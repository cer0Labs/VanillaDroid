-- VanillaDroid Setup (fase 22, ADR-0005 §4-§5): la herramienta de consola vdsetup y, más adelante, su ventana
-- (tools/setup), y la página que el servidor local muestra al móvil. Traduce nuestras claves (VD_SETUP_*).

VD_SETUP_TITLE = "VanillaDroid Setup %s";
VD_SETUP_USAGE = "Prepara World of Warcraft 1.12.1 para VanillaDroid en tu móvil: comprueba tu WoW, convierte sus datos en los packs del móvil y se los envía.\n\nUso: vdsetup <orden> [opciones]\n\n  status                             qué está listo: el WoW, los packs, la app, adb\n  wow <carpeta> [--locale-client <carpeta>|none] [--include \"a.MPQ;b.MPQ\"|none]\n                                     elegir y comprobar tu WoW 1.12.1 (y un segundo cliente en otro idioma)\n  bake [--only <paso>] [--force]     hornear los packs que faltan o están anticuados (--force: todos)\n  serve [--port 47800] [--ip <dirección>] [--wow] [--new-key]\n                                     dar la app y los packs al móvil por Wi-Fi (código QR y código de vinculación)\n  adb help|setup|pair|connect|devices|install|push|send-wow [--serial <dispositivo>] [--accept]\n                                     lo mismo por cable o depuración inalámbrica (adb help: paso a paso)\n  lang [enUS|esES|system]            el idioma de esta herramienta\n  update [--check]                   actualizar VanillaDroid Setup y descargar la app nueva (--check: solo decir qué hay de nuevo)\n\nOpciones de todas las órdenes: --data-dir <carpeta> (ajustes), --packs <carpeta>, --apk <fichero>, --app-id <id>, --verbose";
