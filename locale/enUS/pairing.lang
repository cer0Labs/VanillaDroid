-- Pair with the PC (the QR code)
VD_PAIR_QR_TITLE = "Pair with the PC";
VD_PAIR_QR_STEPS = "1. On your PC, open VanillaDroid Setup and choose \"Connect phone\" (in a console: vdsetup serve).\n\n2. Scan the QR code it shows with this phone's camera: a page from your PC opens.\n\n3. On that page, tap \"%s\": VanillaDroid opens again here and downloads the data.\n\nThe phone and the PC must be on the same Wi-Fi."; -- %s: the page's button (VD_SETUP_PAGE_PAIR)
