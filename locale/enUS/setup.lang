-- VanillaDroid Setup (phase 22, ADR-0005 §4-§5): the console tool vdsetup and, later, its window (tools/setup), and the
-- page the local server shows the phone. English, VanillaDroid's own texts only; built into the tool (it has no packs).
-- Syntax and rules: see common.lang.

VD_SETUP_TITLE = "VanillaDroid Setup %s";
VD_SETUP_USAGE = "Prepares World of Warcraft 1.12.1 for VanillaDroid on your phone: it checks your WoW, turns its data into the phone's packs and sends them to the phone.\n\nUsage: vdsetup <command> [options]\n\n  status                             what is ready: the WoW, the packs, the app, adb\n  wow <folder> [--locale-client <folder>|none] [--include \"a.MPQ;b.MPQ\"|none]\n                                     choose and check your WoW 1.12.1 (and a second client in another language)\n  bake [--only <step>] [--force]     bake the packs that are missing or out of date (--force: all of them)\n  serve [--port 47800] [--ip <address>] [--wow] [--new-key]\n                                     serve the app and the packs to the phone over Wi-Fi (QR code and pairing code)\n  adb help|setup|pair|connect|devices|install|push|send-wow [--serial <device>] [--accept]\n                                     the same by cable or wireless debugging (adb help: step by step)\n  lang [enUS|esES|system]            the language of this tool\n  update [--check]                   update VanillaDroid Setup and get the new app (--check: only say what is new)\n\nOptions for every command: --data-dir <folder> (settings), --packs <folder>, --apk <file>, --app-id <id>, --verbose";
VD_SETUP_UNKNOWN_COMMAND = "Unknown command: %s";
