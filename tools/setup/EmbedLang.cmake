# Phase 22 (setup): locale/<locale>/setup.lang turned into a C++ header (vd_setup_lang.gen.h). VanillaDroid Setup has
# no packs to read its texts from, so they are built into it (tools/setup/SetupText.cpp parses them at startup).
#   cmake -DOUTPUT=<header> "-DINPUTS=<file>|<file>..." -P EmbedLang.cmake
string(REPLACE "|" ";" files "${INPUTS}")
set(arrays "")
set(table "")
set(index 0)
foreach(file IN LISTS files)
    get_filename_component(dir "${file}" DIRECTORY)
    get_filename_component(locale "${dir}" NAME)
    file(READ "${file}" hex HEX)
    string(LENGTH "${hex}" length)
    math(EXPR size "${length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],))"
           "\\1\n" bytes "${bytes}")
    string(APPEND arrays "inline constexpr unsigned char kSetupLang${index}[] = {\n${bytes}0};\n")
    string(APPEND table "    {\"${locale}\", kSetupLang${index}, ${size}u},\n")
    math(EXPR index "${index} + 1")
endforeach()
if(index EQUAL 0)
    message(FATAL_ERROR "EmbedLang: no setup.lang files")
endif()
file(WRITE "${OUTPUT}.tmp"
"// Generated by tools/setup/EmbedLang.cmake from locale/<locale>/setup.lang (phase 22): do not edit.
#pragma once

namespace vd::setup::generated {

struct SetupLanguage {
    const char* locale;
    const unsigned char* data;
    unsigned size;
};

${arrays}
inline constexpr SetupLanguage kSetupLanguages[] = {
${table}};

} // namespace vd::setup::generated
")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}")
file(REMOVE "${OUTPUT}.tmp")
