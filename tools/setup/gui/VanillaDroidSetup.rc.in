// VanillaDroid Setup's Windows resources (phase 22, gui): the icon Explorer and the taskbar show (SDL takes the first
// icon of the program for its window) and the version. CMake fills it in (tools/setup/gui/CMakeLists.txt).
#include <winver.h>

1 ICON "@VD_SETUP_ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @VD_SETUP_VERSION_MAJOR@,@VD_SETUP_VERSION_MINOR@,@VD_SETUP_VERSION_PATCH@,0
PRODUCTVERSION @VD_SETUP_VERSION_MAJOR@,@VD_SETUP_VERSION_MINOR@,@VD_SETUP_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "VanillaDroid Setup"
            VALUE "FileVersion", "@VD_VERSION@"
            VALUE "InternalName", "VanillaDroidSetup"
            VALUE "OriginalFilename", "VanillaDroidSetup.exe"
            VALUE "ProductName", "VanillaDroid"
            VALUE "ProductVersion", "@VD_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
