# Phase 22 (gui): files built into VanillaDroid Setup's window (its font and its logo) as a C++ header, so the program
# is one file that needs nothing next to it to draw itself.
#   cmake -DOUTPUT=<header> "-DINPUTS=<name>=<file>|<name>=<file>..." -P EmbedFiles.cmake
string(REPLACE "|" ";" inputs "${INPUTS}")
string(REPEAT "0x[0-9a-f][0-9a-f]," 16 line)
set(arrays "")
foreach(input IN LISTS inputs)
    string(FIND "${input}" "=" equals)
    string(SUBSTRING "${input}" 0 ${equals} name)
    math(EXPR start "${equals} + 1")
    string(SUBSTRING "${input}" ${start} -1 file)
    file(READ "${file}" hex HEX)
    string(LENGTH "${hex}" length)
    if(length EQUAL 0)
        message(FATAL_ERROR "EmbedFiles: ${file} is empty")
    endif()
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "(${line})" "\\1\n" bytes "${bytes}") # 16 bytes a line
    string(APPEND arrays "inline constexpr unsigned char ${name}[] = {\n${bytes}};\n\n")
endforeach()
file(WRITE "${OUTPUT}.tmp"
"// Generated by tools/setup/gui/EmbedFiles.cmake (phase 22): do not edit.
#pragma once

namespace vd::setup::gui::generated {

${arrays}} // namespace vd::setup::gui::generated
")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}")
file(REMOVE "${OUTPUT}.tmp")
