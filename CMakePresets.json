{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows x64 (VS 2019 Build Tools)",
      "generator": "Visual Studio 16 2019",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows",
      "cacheVariables": {
        "VD_BUILD_TOOLS": "ON",
        "VD_BUILD_TESTS": "ON",
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5"
      }
    },
    {
      "name": "windows-vs2022",
      "displayName": "Windows x64 (Visual Studio 2022): VanillaDroid Setup and the baker as published (release CI)",
      "inherits": "windows",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/windows-vs2022",
      "cacheVariables": {
        "VD_BUILD_TESTS": "OFF",
        "VD_BUILD_GAME": "OFF",
        "VD_DIST": "ON",
        "VD_WOW_DIR": "",
        "VD_WOW_LOCALE_DIRS": "",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-debug", "configurePreset": "windows", "configuration": "Debug" },
    { "name": "windows-release", "configurePreset": "windows", "configuration": "RelWithDebInfo" },
    { "name": "windows-vs2022-release", "configurePreset": "windows-vs2022", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows",
      "configuration": "RelWithDebInfo",
      "output": { "outputOnFailure": true }
    }
  ]
}
